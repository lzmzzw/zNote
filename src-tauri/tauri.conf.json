{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "zNote",
  "version": "0.1.3",
  "identifier": "com.personal.znote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "zNote",
        "decorations": false,
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.github.com; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "个人文本与 Markdown 编辑器",
    "fileAssociations": [
      {
        "ext": ["txt", "md", "markdown", "json", "jsonc", "geojson", "csv", "log", "yaml", "yml", "toml", "xml", "html", "css", "js", "ts", "rs", "sql"],
        "name": "zNote 文本文件",
        "description": "zNote 文本文件"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "resources": [
      "../THIRD_PARTY_NOTICES.txt",
      "../resources/licenses/"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGMEMxRDM1RDFFODJCQzIKUldUQ0sralJOUjBNbjkrN2RlNUR1T2kvaEhjakFMYWNrWTdSTkpwZTNmMmFRb24wTzA0Q1JXQWQK",
      "endpoints": ["https://github.com/lzmzzw/zNote/releases/latest/download/latest.json"]
    }
  }
}
